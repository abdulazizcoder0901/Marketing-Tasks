# --- Telegram ---
# @BotFather dan olingan token
TELEGRAM_BOT_TOKEN=123456:ABC...
# Botdan foydalanishga ruxsat berilgan Telegram ID(lar), vergul bilan.
# Bo'sh qoldirsangiz, /start bosganingizda bot ID'ingizni ko'rsatadi.
ALLOWED_TELEGRAM_IDS=

# --- Notion ---
# https://www.notion.so/my-integrations -> Internal integration secret
NOTION_TOKEN=ntn_...
# Tasklar bazasi ID'si (bazaning linkidagi 32 belgili qism)
NOTION_DATABASE_ID=
# Sizning Notion user ID'ingiz (botda /users buyrug'i orqali topasiz)
NOTION_USER_ID=

# --- Bazadagi ustun (property) nomlari ---
PROP_STATUS=Status
PROP_ASSIGNEE=Assignee
PROP_DUE=Due
# "Bajarilgan" deb hisoblanadigan status nomi
STATUS_DONE=Done

# --- Eslatmalar ---
TIMEZONE=Asia/Tashkent
# Yangi tasklarni necha daqiqada tekshirish
POLL_MINUTES=5
# Har kuni ertalabki xulosa vaqti (HH:MM), o'chirish uchun bo'sh qoldiring
DIGEST_TIME=09:00
