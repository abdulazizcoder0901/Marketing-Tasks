// Cloudflare sozlamalari: GitHub'ga push qilinganda Workers Builds shu fayl bo'yicha
// worker'ni avtomatik yangilaydi. Tokenlar (secrets) dashboard'da saqlanadi.
{
  "name": "ieltszone-tasks",
  "main": "worker.js",
  "compatibility_date": "2025-09-01",
  // Dashboard'da kiritilgan Text o'zgaruvchilar (ALLOWED_TELEGRAM_IDS, NOTION_USER_ID...) o'chmasin
  "keep_vars": true,
  "kv_namespaces": [{ "binding": "KV", "id": "eb0f6f5a5f5e4a5bbc63ad2d36bd99ff" }],
  "triggers": {
    // Vaqtlar UTC'da (Toshkent = UTC+5):
    // - kunduzi 09:00–20:40 har 20 daqiqada yangi tasklar va eslatmalar
    // - kechasi 21:00, 23:00, 01:00, 03:00, 05:00, 07:00 da (har 2 soatda)
    // - 09:00 da ertalabki xulosa
    "crons": ["*/20 4-15 * * *", "0 16,18,20,22,0,2 * * *", "0 4 * * *"]
  }
}
